POSTGRES_DB=fintrack_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

JWT_SECRET=replace-with-a-secure-secret
JWT_ISSUER=FinTrack
JWT_AUDIENCE=FinTrackMobile
JWT_EXPIRATION_MINUTES=1440

ASPNETCORE_ENVIRONMENT=Development

# SSO stays off until a provider is enabled and its credentials are set.
# See docs/sso.md. Do not commit real client secrets.
SSO_ALLOW_REGISTRATION=true
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/sso/callback
SSO_APP_CALLBACK_URI=fintrack://sso/callback
SSO_POST_LOGOUT_REDIRECT_URI=fintrack://sso/logout

SSO_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SSO_MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

SSO_OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER_URI=
OIDC_DISPLAY_NAME=Single sign-on
